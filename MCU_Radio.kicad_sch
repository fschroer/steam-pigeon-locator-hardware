							)
						)
					)
				)
			)
			(embedded_fonts no)
		)
	)
	(text "LoRa radio: Semtech SX1262, 915 MHz high-power PA (+22 dBm max). Same radio core as the STM32WL, so the receiver link is unchanged.\nSPI shared with flash/IMU/baro. DIO2 drives the RF switch, DIO3 powers the TCXO (set 3.0 V in firmware: TG2016SMN needs 2.66-3.465 V; VBAT must stay >= 3.2 V)."
		(exclude_from_sim no)
		(at 177.8 12.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "03cd750c-274b-5847-8d2c-40fc849bc9e0")
	)
	(text "MCU: Nordic nRF54L15 (QFN-48). Fast SPI (SPIM00) on port P2; I2C, ADC and PWM on P1; UART on P0.\nP2.10 is spare (planned IMU INT1). SWD on dedicated pins; no SWO/JTDI."
		(exclude_from_sim no)
		(at 12.7 12.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "215a75ed-3fb2-53fe-ac03-89f971f78734")
	)
	(text "SX1262 RF network = Semtech US915 reference design (SX1262MB1PAS E449V01A BOM; E428V03A and E499V01B list identical RF values). Ref-design designators:\nTX: R58=L2 (0R), L6=L1 (PA choke), C59=C3 (not fitted), L8||C56=L3||C4 (2nd-harmonic notch), C57=C5, C58=C6 (DC block), L10=L4, C65=C7.\nRX: C60=C11, L9=L6 (RFI_N-RFI_P), C64=C12, C66=C13 (not fitted). VR_PA decoupling C54/C55 = C1/C2. Antenna side: C62=C8, C68=C9, L11=L5, C69=C10.\nAll RF parts 0402: Murata GJM1555 C0G caps, LQW15 wirewound inductors (MPN field). Values tuned on Semtech PCB; expect to re-tune on this board."
		(exclude_from_sim no)
		(at 12.7 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "52adc4ca-8b0d-5f77-a881-6878878c42b0")
	)
	(text "RF switch: DIO2 is high during TX; CTRL high selects RF1 (TX) as in the Semtech reference design. RF_LORA goes to J7 (U.FL).\nC62/C68/L11/C69 = Semtech harmonic + RX filter after the switch (C8/C9/L5/C10). Antenna matching not included."
		(exclude_from_sim no)
		(at 12.7 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "772d0fd8-3973-5e5b-8855-b26d3814b8bf")
	)
	(text "nRF54L15 crystals use the internal load capacitors (XOSC32M/XOSC32KI INTCAP, set in firmware), as in Nordic config 1 (no external load caps)."
		(exclude_from_sim no)
		(at 12.7 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9e98f9a8-cba6-5bb5-9131-ce7c746a14cd")
	)
	(text "nRF54L15 support per Nordic PS \"Circuit configuration 1 for QFN48\" (DC/DC on): C39 10uF + C40 at pins 47/48; C41-C43 at pins 10/22/36; C45 on DECD;\nFB1 feeds DECA/DECRF from DECD with C70 2.2uF, C44 10nF (at DECA pin 43) and C71 2.2nF (at DECRF pin 33); R59 1k series reset; C72 3.9pF on SWDIO.\nNordic uses 0201 for these; 0402 here (place each cap at its pin)."
		(exclude_from_sim no)
		(at 12.7 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ab84096f-2348-59e6-a8cf-d8d01a3cb4c7")
	)
	(text "I2C I/O expander, address 0x20 (A2..A0 = 0), shares I2C2 with GPS (0x42) and magnetometer (0x30).\nSlow signals only: status LEDs, continuity-sense enable (DSON) and battery-read enable (BATTRD).\nOutputs power up as inputs with ~100k pull-ups: LEDs off, DSON off, BATTRD on until firmware drives it. P5..P7 spare (power-off FET, MSW sense)."
		(exclude_from_sim no)
		(at 12.7 256.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b3b8df29-30f8-5452-a89c-dd368cc737f4")
	)
	(text "2.4 GHz BLE match = Nordic config 1: ANT - L2 2.7nH - C46 1.5pF - L3 3.5nH - C47 2.0pF - L4 3.5nH - C73 0.3pF - antenna (LQP03HQ / GJM0335 WB, 0201).\nLayout: C46 grounds ONLY to VSS_PA (pin 32), which joins GND only at the centre pad (pin 49); C47 grounds only to the bottom ground layer. L4, C73, AE1 not fitted until BLE."
		(exclude_from_sim no)
		(at 12.7 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d6a62881-6aba-56b9-967e-a401f443cc5c")
	)
